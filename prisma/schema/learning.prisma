// Learning progress persistence. One row per official submission and its test
// results, plus replay/hint events and per-problem progress. Deliberately does
// NOT store raw Pyodide trace steps — a replay is regenerated locally from the
// saved `source` + the problem's test args (docs: cheaper, and no trace leaves
// the browser, per specs/02-trace-contract.md).
//
// Every table here is user-scoped, so each one's create migration ENABLEs ROW
// LEVEL SECURITY (no policy, never FORCE) — a sanctioned hand-written migration
// per docs/rules/migrations.md; `pnpm check:rls` enforces it in CI.
//
// Client-reported pass/fail is untrusted TELEMETRY, not server-verified grading
// (ADR-0001): these rows record what the learner's browser said happened.

model Attempt {
	id          String   @id @default(uuid()) @db.Uuid
	userId      String   @db.Uuid
	problemSlug String
	createdAt   DateTime @default(now()) @db.Timestamptz(6)
	source      String
	status      String
	testsPassed Int
	testsTotal  Int
	allPassed   Boolean

	// M7.1: versioned structural fingerprint of `source` (CodeFeatures, parsed in
	// the browser — never executed on the server). Null for attempts made before
	// M7 and until the bounded browser backfill reaches them; readers must treat
	// null as "no features". Validated on write (codeFeaturesSchema).
	codeFeatures Json?

	// M9A.1: the SERVER's verdict that `source` is real work for the streak, i.e.
	// not the problem's untouched starter and not a whitespace/comment-only edit of
	// it (src/lib/streak/attempt-meaning.ts). Never taken from the client. Null for
	// attempts saved before this column existed — they cannot be re-judged with
	// confidence, so they are kept as they were and still count if completed.
	meaningful Boolean?

	user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
	testResults AttemptTestResult[]
	replays     ReplaySession[]

	@@index([userId, problemSlug])
	// M9A.2: the activity/streak read filters one learner's attempts by a date window
	// and orders by createdAt (src/lib/activity/activity-query.ts).
	@@index([userId, createdAt])
	@@map("attempts")
}

model AttemptTestResult {
	id           String  @id @default(uuid()) @db.Uuid
	attemptId    String  @db.Uuid
	testId       String
	passed       Boolean
	expected     Json
	actual       Json?
	errorType    String?
	errorMessage String?

	attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

	@@index([attemptId])
	@@map("attempt_test_results")
}

model ReplaySession {
	id         String   @id @default(uuid()) @db.Uuid
	userId     String   @db.Uuid
	attemptId  String   @db.Uuid
	testId     String
	startedAt  DateTime @default(now()) @db.Timestamptz(6)
	testPassed Boolean

	user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
	attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

	@@index([userId])
	@@index([attemptId])
	@@map("replay_sessions")
}

model LearningEvent {
	id          String   @id @default(uuid()) @db.Uuid
	userId      String   @db.Uuid
	problemSlug String
	type        String // 'replay_inspected' | 'hint_revealed' | 'milestone_reached'
	detail      String? // small enum-ish token (hint id, milestone name) — never PII/free text
	createdAt   DateTime @default(now()) @db.Timestamptz(6)

	user User @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@index([userId, problemSlug])
	@@map("learning_events")
}

model ProblemProgress {
	userId          String    @db.Uuid
	problemSlug     String
	status          String // 'attempted' | 'solved'
	attempts        Int       @default(0)
	bestTestsPassed Int       @default(0)
	testsTotal      Int       @default(0)
	firstSolvedAt   DateTime? @db.Timestamptz(6)
	latestSolvedAt  DateTime? @db.Timestamptz(6)
	updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

	user User @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@id([userId, problemSlug])
	@@map("problem_progress")
}

// A learner's own note on a problem (specs/features/problem-notes.md): plain
// text, at most 2 000 characters, one per learner per problem. An empty note is
// deleted rather than stored.
model ProblemNote {
	userId      String   @db.Uuid
	problemSlug String
	body        String
	updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

	user User @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@id([userId, problemSlug])
	@@map("problem_notes")
}
