// The base User model. One .prisma file per domain area (e.g. authz.prisma,
// flags.prisma), all under prisma/schema/. Prisma reads every *.prisma file in
// the folder as one combined schema.
//
// User.id is NOT @default — per docs/rules/auth.md, this template's convention
// is that User.id IS the Supabase auth user's uuid, set explicitly when the row
// is first created (provisionUser, from an auth webhook or on first sign-in),
// never generated app-side. @db.Uuid matches AdminMember.userId @db.Uuid
// (prisma/schema/authz.prisma) so the FK types agree.
//
// users is user-scoped, so its create migration ENABLEs ROW LEVEL SECURITY
// (no policy, no FORCE) — see docs/rules/authorization.md.
model User {
	id          String       @id @db.Uuid
	email       String       @unique
	createdAt   DateTime     @default(now()) @db.Timestamptz(6)
	updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
	adminMember AdminMember?

	// M9A.3: public developer-profile settings (prisma/schema/profile.prisma). Both
	// are opt-in: `username` is null until the owner picks one, and every account —
	// existing ones included — starts PRIVATE, so nobody is exposed by this migration.
	// `username` is always stored normalised (lowercase, URL-safe: src/lib/profile/
	// username.ts), so this plain unique index IS the case-insensitive uniqueness.
	username          String?           @unique
	profileVisibility ProfileVisibility @default(PRIVATE)

	// Learning domain (prisma/schema/learning.prisma). Virtual back-relations —
	// no column on users; the FK columns live on the child tables.
	attempts        Attempt[]
	replaySessions  ReplaySession[]
	learningEvents  LearningEvent[]
	problemProgress ProblemProgress[]
	// M9C spaced review (prisma/schema/reviews.prisma).
	problemReviews  ProblemReview[]

	// M9B daily challenges (prisma/schema/challenges.prisma). `leaderboardOptIn` is the
	// SEPARATE explicit consent to appear on the public weekly leaderboard: a public
	// profile alone never implies it, and it defaults to false for every account.
	leaderboardOptIn  Boolean            @default(false)
	challengeAttempts ChallengeAttempt[]
	weeklyStandings   WeeklyStanding[]

	// M10 Daily Exam (prisma/schema/exams.prisma). `leaderboardOptIn` above is reused as the
	// explicit consent to a public leaderboard identity; without it a learner is anonymous.
	examAttempts  ExamAttempt[]
	examStandings ExamStanding[]

	// M7.5 recommendation persistence (prisma/schema/recommendations.prisma).
	recommendationCache RecommendationCache?

	// M7.5B notifications (prisma/schema/notifications.prisma).
	notificationPreference NotificationPreference?
	learningNotifications  LearningNotification[]
	notificationDeliveries NotificationDelivery[]

	@@map("users")
}
